# ============================================
# EAZY V2 BACKEND
# ============================================
# This file is a source-derived template only.
# Put real values in Railway or another secret manager.
# Never commit production credentials.

# ----------------
# CORE
# ----------------
# Runtime mode. Set production on Railway.
NODE_ENV=production
# Railway normally provides PORT. Leave empty unless an override is required.
PORT=
# Pino log threshold. Default: info.
LOG_LEVEL=info
# Browser client origin. Required for a restricted production CORS policy.
CORS_ORIGIN=
# Set true only when the deployment proxy is trusted.
TRUST_PROXY=false
# Recommended behind a correctly configured HTTPS proxy.
ENFORCE_HTTPS=true

# ----------------
# SUPABASE STORAGE / MEDIA
# ----------------
# Required for durable private media and signed upload/read URLs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MEDIA_BUCKET=eazy-media

# ----------------
# DATABASE
# ----------------
# Required for the complete database-backed backend. Supabase PostgreSQL URL.
DATABASE_URL=
# Pool tuning. Optional; source defaults apply when blank.
DB_POOL_MAX=
DB_IDLE_TIMEOUT_MS=
DB_CONNECTION_TIMEOUT_MS=

# ----------------
# FIREBASE AUTHENTICATION
# ----------------
# All three credential fields are required together for live Firebase auth.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Firebase service-account private key. Escaped backslash-n sequences are
# accepted and converted to newlines.
FIREBASE_PRIVATE_KEY=
# Default: true. Keep token revocation checks enabled.
FIREBASE_CHECK_REVOKED=true
# Default: 30 days; maximum: 90.
EAZY_SESSION_TTL_DAYS=30

# ----------------
# EMAIL VERIFICATION / RESEND
# ----------------
# Required for email-code signup. Keep the API key server-side in Railway.
RESEND_API_KEY=
# Must be a verified Resend sender, for example noreply@your-domain.com.
RESEND_FROM_EMAIL=
# Optional Reply-To header for verification mail. This does not create an
# inbound mailbox or forwarding rule; configure that separately with the mail
# provider. A practical launch value is support@eazy.name.ng after verification.
RESEND_REPLY_TO_EMAIL=
# Defaults: 10 minutes and 5 failed attempts.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ----------------
# RATE LIMITING
# ----------------
# Optional tuning; defaults are 60000 ms and 120 requests.
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=

# ----------------
# EAZY ASSIST
# ----------------
# Optional. Leave all three selection fields blank to disable Assist provider calls.
# Set all three together to enable the OpenAI-compatible adapter.
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
# Optional; default: 15000 ms.
AI_PROVIDER_TIMEOUT_MS=

# ----------------
# TRANSLATION
# ----------------
# Optional. Leave all translation fields blank to use the unavailable adapter.
# Supported values: deepl (default) or google.
TRANSLATION_PROVIDER=deepl
# DeepL API key. Keep it server-side in Railway.
TRANSLATION_PROVIDER_API_KEY=
# Optional HTTPS override. For DeepL API Free use https://api-free.deepl.com/v2/translate; for paid DeepL API use https://api.deepl.com/v2/translate. Leave blank for the DeepL Free endpoint.
TRANSLATION_PROVIDER_BASE_URL=
# Optional; default: 10000 ms.
TRANSLATION_PROVIDER_TIMEOUT_MS=

# ----------------
# LOCATION
# ----------------
# Optional. Leave all location fields blank to use the unavailable adapter.
# Set the API key to enable HERE Geocoding and Search.
LOCATION_PROVIDER_API_KEY=
# Optional HTTPS overrides. Leave blank to use HERE defaults.
LOCATION_GEOCODE_BASE_URL=
LOCATION_SEARCH_BASE_URL=
# Optional; default: 10000 ms.
LOCATION_PROVIDER_TIMEOUT_MS=

# ----------------
# PAYMENTS / PAYSTACK
# ----------------
# OPTIONAL. Leave false/blank to keep payment initialization unavailable.
PAYSTACK_ENABLED=false
# Use test while sandbox-testing; use live only after merchant verification.
PAYSTACK_MODE=test
# REQUIRED when PAYSTACK_ENABLED=true. Keep server-side only.
PAYSTACK_SECRET_KEY=
# Optional; defaults to PAYSTACK_SECRET_KEY when blank.
PAYSTACK_WEBHOOK_SECRET=
# Optional HTTPS callback URL used by Paystack checkout.
PAYMENT_CALLBACK_URL=

# ----------------
# NOTIFICATIONS / FCM
# ----------------
# FCM is PROVIDER ENABLED WHEN the three Firebase Admin fields above are complete.
# Device tokens are registered by the authenticated frontend at /v1/notifications/devices.

# ----------------
# SUPABASE DATABASE METADATA
# ----------------
# Optional deployment metadata. DATABASE_URL remains the active PostgreSQL connection.
SUPABASE_PROJECT_REF=
SUPABASE_DB_HOST=

# Paybeta, Telegram, and SMS credentials are not consumed by the current runtime.
# Do not add them to Railway unless a corresponding adapter is intentionally implemented and documented.
