{
  "name": "eazy-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Eazy production API backend",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "test": "tsx --test test/**/*.test.ts",
    "test:storage-integration": "tsx test/supabase_storage.integration.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx src/database/migrate.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "firebase-admin": "^13.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "ws": "^8.21.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
